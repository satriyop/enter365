includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - config/
        - database/
        - routes/
        - tests/

    # Level 5 - A solid baseline for professional projects. 
    # Aim to increase this to 8 or 9 incrementally.
    level: 5

    # Ensure model properties are checked against the database schema/migrations.
    checkModelProperties: true

    # Standard Laravel ignore for builder methods
    ignoreErrors:
        - '#Call to an undefined method Illuminate\Database\Eloquent\Builder::#'

    excludePaths:
        analyseAndScan:
            - app/Console/Commands/Playground.php (?)
            # Incomplete strategy implementations
            - app/Services/Accounting/Strategies/Manufacturing/JobCostingStrategy.php
            - app/Services/Accounting/Strategies/Manufacturing/ProjectBasedCostingStrategy.php
            - app/Services/Accounting/Strategies/Manufacturing/WIPAccountingStrategy.php

    # Laravel-specific settings
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
