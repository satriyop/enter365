APP_NAME=Enter365
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://enter365.pamungkas.org

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=enter365
DB_USERNAME=enter365
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.pamungkas.org
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@enter365.pamungkas.org"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=enter365.pamungkas.org

# Kopitiam 57 live till (Moka Add: cafe tile + 5% service + 10% PBJT)
FEATURE_PRESET=pos
FEATURE_POS=true
POS_PRICING_MODE=add
POS_SERVICE_RATE=5
POS_TAX_RATE=10
POS_TAX_NAME=PBJT

API_RESPONSE_VALIDATION_ENABLED=false
API_RESPONSE_VALIDATION_STRICT=false
