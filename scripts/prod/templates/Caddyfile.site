# Enter365 — same origin SPA + Laravel API
# Installed as /etc/caddy/sites/enter365.pamungkas.org.caddy
# Imported from /etc/caddy/Caddyfile

__DOMAIN__ {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
	}

	# Laravel health
	handle /up {
		root * __APP_DIR__/public
		php_fastcgi unix/__PHP_SOCK__
	}

	handle /api* {
		root * __APP_DIR__/public
		php_fastcgi unix/__PHP_SOCK__
		file_server
	}

	handle /storage* {
		root * __APP_DIR__/public
		file_server
	}

	# Till catalog photos (not the Vue /kasir route)
	handle /pos/kopitiam* {
		root * __APP_DIR__/public
		file_server
	}

	handle {
		root * __SPA_DIR__
		try_files {path} /index.html
		file_server
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
	}
}
