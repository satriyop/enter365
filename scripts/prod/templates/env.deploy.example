# Enter365 Remote Deployment Configuration
# Copy this file to .env.deploy in the project root or scripts/prod/.env.deploy
# Never commit .env.deploy to git!

AIDEV_IP=your-server-ip
AIDEV_HOST=root@aidev
DOMAIN=enter365.example.com
APP_DIR=/var/www/enter365
SPA_DIR=/var/www/enter365-spa
APP_USER=www-data
DB_NAME=enter365
DB_USER=enter365
SSH_KEY_FILE=~/.ssh/id_ed25519
